{
  "name": "blog-tech",
  "version": "1.0.0",
  "description": "Blog kỹ thuật đa ngôn ngữ — nội dung markdown, giao diện tĩnh chạy được offline",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i assets/css/input.css -o assets/css/tailwind.css --minify",
    "build": "npm run build:css && node build/build.js",
    "dist": "npm run build && node build/dist.js",
    "test": "node --test build/*.test.js",
    "serve": "python3 -m http.server 8080",
    "serve:dist": "python3 -m http.server 8080 --directory dist"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "^3.4.19"
  }
}
