{
  "name": "blog-tech",
  "version": "1.0.0",
  "description": "Blog kỹ thuật đa ngôn ngữ — nội dung markdown, giao diện tĩnh chạy được offline",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i assets/css/input.css -o assets/css/tailwind.css --minify",
    "build": "npm run build:css && node build/build.js && vite build",
    "dev": "node build/build.js && vite",
    "preview": "vite preview",
    "test": "node --test build/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1"
  }
}
